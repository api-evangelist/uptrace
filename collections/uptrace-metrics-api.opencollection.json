{
  "opencollection": "1.0.0",
  "info": {
    "name": "Uptrace Alerts Metrics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prometheus Remote Write",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uptrace.dev/api/v1/prometheus/write"
          },
          "docs": "Ingest Prometheus metrics into Uptrace using the Prometheus Remote Write protocol (protobuf-encoded snappy-compressed timeseries data)."
        },
        {
          "info": {
            "name": "Prometheus Query Range",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uptrace.dev/api/prometheus/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Uptrace project ID or 'default'"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "PromQL query expression"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Start timestamp (Unix or RFC3339)"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "End timestamp (Unix or RFC3339)"
              },
              {
                "name": "step",
                "value": "",
                "type": "query",
                "description": "Query resolution step (e.g., 15s, 1m)"
              }
            ]
          },
          "docs": "Query Uptrace metrics using PromQL over a time range. Compatible with Grafana's Prometheus data source and standard Prometheus HTTP API."
        }
      ]
    }
  ],
  "bundled": true
}